# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults shown.
# HOST=127.0.0.1
# PORT=8787
# TRANSCRIBE_MODEL=gpt-live-transcribe
# REFINE_MODEL=gpt-6-luna

# Optional. What OpenAI charges for the models above, in US dollars, to tell the app what a
# dictation cost: a minute of audio transcribed, and a million tokens the refinement reads
# and writes. Defaults shown. https://developers.openai.com/api/docs/pricing
# TRANSCRIBE_PRICE_PER_MINUTE=0.017
# REFINE_PRICE_PER_MILLION_INPUT=0.10
# REFINE_PRICE_PER_MILLION_OUTPUT=0.50

# Optional. Logs are pretty in a terminal and JSON elsewhere. See docs/logging.md.
# LOG_FORMAT=pretty
# LOG_LEVEL=info

# Optional. Comma-separated ISO 639-1 codes of the languages you dictate in.
# TRANSCRIBE_LANGUAGES=en,pt
